# Backend Environment Variables (FastAPI / Render)
# Copy this file to .env and fill in your values

# PostgreSQL connection string (Supabase)
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# JWT Secret Key — generate a strong random string for production!
# JWT_SECRET_KEY=your-strong-random-secret-here

# CORS Allowed Origins (comma-separated, no spaces around commas)
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Port (Render sets this automatically, no need to set manually)
# PORT=8000
